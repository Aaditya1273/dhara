# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated https origins when served behind a domain, e.g. https://dhara.example.org
CSRF_TRUSTED_ORIGINS=

# Leave empty for local SQLite. Production: postgres://USER:PASSWORD@HOST:5432/DB (e.g. Amazon RDS)
DATABASE_URL=

TIME_ZONE=Asia/Kolkata

# Evidence storage: local (MEDIA_ROOT on disk) or s3 (private Amazon S3 bucket)
STORAGE_BACKEND=local
AWS_REGION=ap-south-1
AWS_STORAGE_BUCKET_NAME=
AWS_S3_PREFIX=dhara
# Credentials: prefer an IAM role (EC2/ECS/App Runner). For local testing only:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Upstream QRInvent subscription billing (YooKassa). Keep False for DHARA.
BILLING_ENABLED=False
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Production HTTPS policy (used only when DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0
LOG_LEVEL=INFO

# Tank Test Priority thresholds (institution policy; defaults follow IS 10500:2012 for chlorine)
PRIORITY_CHLORINE_MIN_MG_L=0.2
PRIORITY_CHLORINE_NEAR_MARGIN_MG_L=0.1
PRIORITY_CHLORINE_MAX_MG_L=1.0
PRIORITY_WATER_WARM_C=25
PRIORITY_FORECAST_HOT_C=35
PRIORITY_CHLORINE_MAX_AGE_HOURS=72
PRIORITY_TEMP_MAX_AGE_HOURS=72
PRIORITY_WARM_RETEST_HOURS=24
