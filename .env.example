# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated https origins when served behind a domain, e.g. https://dhara.example.org
CSRF_TRUSTED_ORIGINS=

# Leave empty for local SQLite. Production: postgres://USER:PASSWORD@HOST:5432/DB (e.g. Amazon RDS)
DATABASE_URL=

TIME_ZONE=Asia/Kolkata

# Evidence storage: local (MEDIA_ROOT on disk) or s3 (private Amazon S3 bucket)
STORAGE_BACKEND=local
AWS_REGION=ap-south-1
AWS_STORAGE_BUCKET_NAME=
AWS_S3_PREFIX=dhara
# Credentials: prefer an IAM role (EC2/ECS/App Runner). For local testing only:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Upstream QRInvent subscription billing (YooKassa). Keep False for DHARA.
BILLING_ENABLED=False
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
